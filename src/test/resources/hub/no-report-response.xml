<?xml version="1.0" encoding="UTF-8"?>
<!-- A response that parses and says nothing: the Hub logs a failure of the rules engine or of
     its own G-Standaard checks rather than raising, so an envelope without a report is a shape
     this interface can really receive. It must never be presented as "no signals found". -->
<ns0:Envelope xmlns:ns0="http://schemas.xmlsoap.org/soap/envelope/">
    <ns0:Body>
        <ns1:MedicationSurveillanceResponse xmlns:ns1="http://hub.digitalis.nl/call">
            <ns1:asDigitalisRx>
                <ns2:DigitalisRx xmlns:ns2="http://digitalis.nl/schema/DigitalisRx">
                    <ns2:ClinicalRules>
                        <ns2:reports/>
                    </ns2:ClinicalRules>
                </ns2:DigitalisRx>
            </ns1:asDigitalisRx>
        </ns1:MedicationSurveillanceResponse>
    </ns0:Body>
</ns0:Envelope>
