                                            <ns2:drug ATC="A02BC01" directionCoded="1D1C HVO; Bij gebruik NSAID" directionCaption="1 X per dag 1 capsule een half uur voor het ontbijt; Bij gebruik NSAID" DDD="20" PDD="1" supplyQuantity="7" supplyUnit="ST" doseQuantity="0" doseUnit="" pending="false" date="2026-09-06T09:05:11+00:00" dateEnd="2026-09-13T09:05:11+00:00" UID="9066">
                                                <ns2:GStandaard HPK="3018040" PRK="60062" GPK="114529" UID="9066" selected="PRK" caption="OMEPRAZOL CAPSULE MSR 20MG"/>
                                                <ns2:RVV codeSystem="ICPC1" codeValue="K86"/>
