  "experimental": false,
  "compose": {
    "include": [
      {
        "system": "http://hl7.org/fhir/administrative-gender",
        "concept": [
          {
            "code": "male",
            "display": "Male"
          },
          {
            "code": "female",
            "display": "Female"
          },
          {
            "code": "unknown",
            "display": "Unknown"
          }
        ]
      }
    ]
  }
}
