{
  "resourceType": "StructureDefinition",
  "id": "fhirhub-Condition",
  "url": "http://spec.digitalis.nl/fhir/StructureDefinition/fhirhub-Condition",
  "version": "0.4.0",
  "name": "FhirHubCondition",
  "title": "fhir-hub Condition",
  "status": "draft",
  "description": "A contra-indication, coded as a G-Standaard CICode or an ICPC-1 NL code.",
  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "Condition",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Condition",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Condition.code",
        "path": "Condition.code",
        "short": "CICode or ICPC-1 NL",
        "min": 1,
        "constraint": [
          {
            "key": "fhirhub-icpc-shape",
            "severity": "error",
            "human": "An ICPC-1 NL code is a letter and two digits, optionally followed by a dot and two more (A01, U71.01).",
            "expression": "coding.where(system = 'urn:oid:2.16.840.1.113883.2.4.4.31.1').all(code.matches('^[A-Z][0-9]{2}(\\\\.[0-9]{2})?$'))",
            "source": "http://spec.digitalis.nl/fhir/StructureDefinition/fhirhub-Condition"
          }
        ],
        "binding": {
          "strength": "required",
          "valueSet": "http://spec.digitalis.nl/fhir/ValueSet/contra-indication"
        }
      },
      {
        "id": "Condition.subject",
        "path": "Condition.subject",
        "comment": "Mandatory in base R4 and not read by fhir-hub. Send a data-absent-reason of 'unknown' if you have nothing to reference."
      }
    ]
  }
}
